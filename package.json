{
  "name": "@gulpjs/update-template",
  "version": "0.3.3",
  "description": "Updates a gulpjs repository to match our current scaffold.",
  "author": "Gulp Team <team@gulpjs.com> (https://gulpjs.com/)",
  "contributors": [
    "Blaine Bublitz <blaine.bublitz@gmail.com> (https://github.com/phated)"
  ],
  "funding": "https://github.com/sponsors/gulpjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gulpjs/update-template.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">= 22.15.0"
  },
  "type": "module",
  "main": "./index.js",
  "bin": {
    "update-template": "index.js"
  },
  "files": [
    "index.js",
    "LICENSE"
  ],
  "scripts": {
    "format-check": "prettier . --check",
    "format-write": "prettier . --write",
    "lint": "eslint .",
    "test": "node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=test/lcov.info \"test/*.js\""
  },
  "dependencies": {
    "boilerplate-update": "npm:@phated/boilerplate-update@^0.37.6",
    "js-yaml": "^4.3.2",
    "remote-git-tags": "^4.0.0",
    "sver": "^2.0.1"
  },
  "devDependencies": {
    "eslint": "10.11.0",
    "eslint-config-gulp": "7.0.0",
    "prettier": "3.9.6"
  },
  "nyc": {
    "reporter": [
      "lcov",
      "text-summary"
    ]
  },
  "keywords": []
}
